// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  password     String?
  githubId     String?       @unique
  avatarUrl    String?
  authProvider String        @default("email") // "email" or "github"
  createdAt    DateTime      @default(now())
  agentapikeys AgentAPIKey[]
  agents       Agent[]
  jobs         Job[]
}

model emailOtp {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String
  expiresAt  DateTime
  isVerified Boolean
  createdAt  DateTime @default(now())
}

model Agent {
  id          String        @id @default(uuid())
  hostname    String        @unique
  os          String
  arch        String //cpu architecture
  totalmem    BigInt
  lastSeen    DateTime
  isOnline    Boolean       @default(true)
  jobs        Job[]
  apiKey      AgentAPIKey?  @relation(fields: [apiKeyId], references: [id])
  apiKeyId    String?       @unique // ensures 1-to-1 link between agent and API key
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  agentHealth AgentHealth[]
}

model Job {
  id          String    @id @default(uuid())
  agent       Agent?    @relation(fields: [agentId], references: [id])
  title       String
  description String?
  agentId     String?
  script      String
  env         Json?
  status      jobStatus @default(Pending)
  exitCode    Int?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  logs        Log[]
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  scheduleAt  DateTime? // For delayed jobs
  repeatCron  String? // For recurring jobs (e.g. cron expression)
  isRecurring Boolean   @default(false)
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  timeoutSec  Int? // Optional: kill long-running jobs
  tags        Json?
}

model Log {
  id        String   @id @default(uuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  type      LogType
  message   String
  createdAt DateTime @default(now())
}

model AgentAPIKey {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  apiKey    String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  agent     Agent?    @relation
  agentId   String?   @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime
  keyName   String?
}

model AgentHealth {
  id        String   @id @default(uuid())
  agent     Agent    @relation(fields: [agentId], references: [id])
  agentId   String
  cpuUsage  Float
  memUsage  Float
  diskUsage Float?
  timestamp DateTime @default(now())
}

enum jobStatus {
  Success
  Failure
  Pending
  Running
}

enum LogType {
  STDOUT
  STDERR
  SYSTEM
}
